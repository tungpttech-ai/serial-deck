#!/bin/sh
# On remove/purge, delete leftover version trees unless a process still runs
# from them (a user's hub); those are removed by the next install or reboot cleanup.
set -e
case "$1" in remove|purge) ;; *) exit 0 ;; esac
for dir in /opt/serial-deck/*/; do
    dir=${dir%/}
    [ -d "$dir" ] || continue
    in_use=0
    for exe in /proc/[0-9]*/exe; do
        target=$(readlink "$exe" 2>/dev/null) || continue
        case "$target" in "$dir"/*) in_use=1; break ;; esac
    done
    [ "$in_use" = 0 ] && rm -rf "$dir"
done
rmdir /opt/serial-deck 2>/dev/null || true
exit 0
